{
  "id": "migu",
  "name": "Migu Music",
  "version": "0.2.3",
  "minAppVersion": "0.1.21",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "process": [
      "bin/migu-web-login-darwin-arm64",
      "bin/migu-web-login-darwin-amd64",
      "bin/migu-web-login-windows-arm64.exe",
      "bin/migu-web-login-windows-amd64.exe"
    ],
    "network": [
      "music.migu.cn",
      "passport.migu.cn",
      "app.c.nf.migu.cn",
      "app.u.nf.migu.cn",
      "c.musicapp.migu.cn",
      "d.musicapp.migu.cn"
    ],
    "requestHeaders": [
      {
        "hosts": ["d.musicapp.migu.cn"],
        "kinds": ["image"],
        "headers": { "referer": "https://music.migu.cn/" }
      }
    ]
  },
  "settings": [
    {
      "key": "signInMethod",
      "label": "Sign-in method",
      "type": "select",
      "options": [
        { "value": "", "label": "QR code sign-in" },
        { "value": "web", "label": "Web sign-in" }
      ]
    }
  ],
  "navigation": [
    { "builtin": "home" },
    { "title": "Charts", "page": "charts", "icon": "chart" },
    { "title": "Playlists", "page": "square", "icon": "playlist" },
    { "title": "Artists", "page": "singers", "icon": "artist" },
    { "builtin": "stations" },
    { "builtin": "liked" },
    { "builtin": "savedAlbums" }
  ]
}
